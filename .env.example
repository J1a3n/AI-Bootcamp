# ==============================================================================
# AI Bootcamp Environment Configuration Template
# Copy this file to .env.local and fill in your keys as you progress through the sprints.
# ==============================================================================

# Sprint 1: Local Engine & Cloud Comparison
OLLAMA_HOST=http://127.0.0.1:11434
GEMINI_API_KEY=your_google_ai_studio_api_key_here
BOOTCAMP_SECRET_TOKEN=generate_a_random_secret_token_for_sprint_1_3

# Sprint 2 & 3: Supabase (Database, Storage & Task Queue)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
